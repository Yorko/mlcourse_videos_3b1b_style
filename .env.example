# Copy to .env and fill in. Without a key, scenes render with silent placeholder audio.
ELEVEN_API_KEY=
# Optional: pick a voice by name or id (defaults to the first voice on your account).
ELEVEN_VOICE_NAME=
ELEVEN_VOICE_ID=
